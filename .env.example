# Copy to .env.local for local development, or set these in Vercel → Project → Settings → Environment Variables.

# Required — MongoDB connection string (local or MongoDB Atlas free tier).
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio
# Optional database name override (otherwise taken from the URI).
# MONGODB_DB=portfolio

# Required in production — public origin used for canonical URLs, sitemap and Open Graph.
SITE_URL=https://your-domain.com

# Required in production — random string, at least 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Admin provisioning (used only by `npm run onboard` / `npm run admin:create`, never by the running site).
# Do not set ADMIN_PASSWORD in Vercel; run the script from your machine against the production database instead.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Required to move between the portfolio (/) and the studio (/studio).
# Visitors stay in the area they first landed in; crossing to the other one asks for this password.
# When empty, crossing is disabled entirely.
SITE_GATE_PASSWORD=

# Optional — lets Admin › Profile sync push your GitHub bio/profile fields and profile README.
# Create a fine-grained token at https://github.com/settings/personal-access-tokens with:
#   Account permissions → Profile: Read and write
#   Repository access → Only <username>/<username>, Repository permissions → Contents: Read and write
# Without it, the GitHub items stay copy-and-paste.
GITHUB_TOKEN=

# Optional — SMTP notifications for contact-form messages.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Optional — comma-separated hostnames next/image may optimize; "none" disables remote optimization.
IMAGE_REMOTE_HOSTS=
